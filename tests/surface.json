    },
    "GrantRequest": {
      "holder_key": "MAX_HOLDER_KEY_LEN",
      "instance": "MAX_INSTANCE_LEN"
    },
    "Link": {
      "segment": "MAX_NAME_LEN"
    },
    "NodeId": {
      "bytes": "MAX_NODE_ID_LEN"
    },
    "PrincipalId": {
